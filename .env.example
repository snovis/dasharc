# ─── App Config ──────────────────────────────────────────────
# Display strings in the UI. Safe to ship to the browser.
VITE_APP_NAME=DashARC
VITE_COMPANY_NAME=SalesARC

# ─── Google Sign-In (client-side) ────────────────────────────
# OAuth 2.0 Client ID from Google Cloud Console → APIs & Services → Credentials.
# Must end with `.apps.googleusercontent.com`. Needs authorized JavaScript
# origins configured for http://localhost:5173, http://localhost:3000, and
# the production Vercel URL.
# At least one of VITE_GOOGLE_CLIENT_ID or VITE_MICROSOFT_CLIENT_ID is required.
VITE_GOOGLE_CLIENT_ID=

# ─── Microsoft Sign-In (client-side) ─────────────────────────
# Application (client) ID from the Azure App Registration (Microsoft Entra ID).
# Register the app as "Single-page application" platform (NOT Web — Web
# requires a client_secret which SPAs can't keep secret). Multi-tenant supported.
# Add the production Vercel URL and http://localhost:5173 as redirect URIs
# under the SPA platform.
VITE_MICROSOFT_CLIENT_ID=

# ─── Synthflow API (server-side, secret) ─────────────────────
# Never prefix with VITE_ — would leak into the browser bundle.
# Used by Vercel serverless functions in /api to proxy Synthflow requests.
# Get from Synthflow dashboard → API keys.
SYNTHFLOW_API_KEY=

# ─── Session cookie (server-side, secret) ────────────────────
# Signs the httpOnly session cookie issued after a Google/Microsoft sign-in,
# so users stay logged in across tabs/restarts without re-verifying a provider
# token every request. Must be a random string of at least 32 chars; the
# server refuses to boot without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Optional: session lifetime in days (default 30).
# SESSION_TTL_DAYS=30

# ─── Multi-tenant config (droplet) ───────────────────────────
# Absolute path to the accounts/users YAML. Defaults to
# config/accounts.local.yaml when unset (local dev). On the droplet:
#   ACCOUNTS_CONFIG_PATH=/etc/dasharc/accounts.yaml
ACCOUNTS_CONFIG_PATH=

# ─── Access Control (legacy single-tenant / optional) ────────
# In the multi-tenant droplet deployment the YAML `users` list is the
# authoritative allowlist and this is left UNSET. If set (legacy Vercel),
# it's an extra coarse gate: comma-separated emails, trimmed, case-insensitive.
ALLOWED_EMAILS=

# Comma-separated Synthflow agent (model_id) UUIDs this deployment surfaces.
# The client only sees calls/agents for IDs in this list. Restrict per-client:
# e.g. a SalesARC→OnSite Medical deployment lists only that agent's ID.
AGENT_IDS=

# n8n webhook URL for manual demo call trigger (SalesARC n8n instance)
N8N_DEMO_TRIGGER_URL=
